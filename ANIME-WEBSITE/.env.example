PORT=3000
HOST=127.0.0.1
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_USER_AGENT=AnimeWebsite/0.4 (+https://github.com/kenmini098-hash/web)
# Optional: use a stable random value of at least 32 bytes outside local development.
# CURSOR_SIGNING_KEY=
# Required only for account database commands; keep the actual connection string in secret storage.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Required for persistent account CSRF/cursor signing; random secret at least 32 bytes.
# ACCOUNT_SECRET=
# Loopback development only; never enable in production.
# LOCAL_HTTP=1
# Optional real PostgreSQL integration tests (creates and removes a temporary schema).
# TEST_DATABASE_URL=
